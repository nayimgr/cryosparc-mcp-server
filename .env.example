# ============================================================
# CryoSPARC MCP Server — Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Only needed for HTTP mode (manual launch).
# For Claude Code stdio mode, use the "env" block in ~/.claude.json.
# ============================================================

# CryoSPARC instance URL (same URL you use in your browser)
CRYOSPARC_BASE_URL=http://localhost:39000

# Authentication — Two options:
#
# OPTION A (recommended for v5): Run this once in your terminal:
#   python -m cryosparc.tools login --url http://localhost:39000
# Then leave EMAIL and PASSWORD empty below. The token is saved locally.
#
# OPTION B (legacy): Provide email and password directly.
CRYOSPARC_EMAIL=
CRYOSPARC_PASSWORD=

# HTTP request timeout in seconds (default: 300)
CRYOSPARC_TIMEOUT=300
